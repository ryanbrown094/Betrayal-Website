# Cache policy for static files, which reach the browser through the Worker (run_worker_first). One exception lives in
# index.js: an image asked for by this build's fingerprint (/media/NAME?v=HASH) is kept a year, immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=604800
/words.txt
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
/build.txt
  Cache-Control: no-cache, must-revalidate
/play.html
  Cache-Control: no-cache, must-revalidate
/g/*
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
